 /*
  * kianv platform early initialization.
  */
 static int kianv_early_init(bool cold_boot)
 {
+	/* Hart 1 enters this firmware at the same address and parks until it is started. */
+	if (cold_boot)
+		writel(1, (void *)KIANV_RUN_ADDR);
 	return 0;
 }
 
+static int kianv_ipi_init(bool cold_boot)
+{
+	int ret;
+
+	if (cold_boot) {
+		ret = aclint_mswi_cold_init(&mswi);
+		if (ret)
+			return ret;
+		ret = aclint_mswi_cold_init(&mswi_b);
+		if (ret)
+			return ret;
+	}
+
+	return aclint_mswi_warm_init();
+}
